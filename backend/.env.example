# Configuracion del backend. Copiar como .env si queres cambiar algo.
# Todo corre local con Whisper: no se necesita ninguna clave ni cuenta en la nube.

# Tamano del modelo de Whisper: tiny | base | small | medium | large-v3
#   small -> rapido y bueno en espanol (recomendado para CPU, ~460 MB)
#   medium -> mas preciso, mas lento (~1.5 GB)
WHISPER_MODEL=small

WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Idiomas soportados (codigo que manda el frontend)
LANGUAGES=es-AR,en-US
